{
	"name": "@neutrium/quantity",
	"version": "7.0.0",
	"packageManager": "pnpm@11.5.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/Quantity.d.ts",
			"import": "./dist/Quantity.js"
		},
		"./parsers.js": {
			"types": "./dist/parsers/index.d.ts",
			"import": "./dist/parsers/index.js"
		},
		"./guards.js": {
			"types": "./dist/guards.d.ts",
			"import": "./dist/guards.js"
		},
		"./regex": {
			"types": "./dist/regex.d.ts",
			"import": "./dist/regex.js"
		},
		"./parsers/nearley": {
			"types": "./dist/parsers/NearleyParser.d.ts",
			"import": "./dist/parsers/NearleyParser.js"
		},
		"./parsers/pratt": {
			"types": "./dist/parsers/PrattParser.d.ts",
			"import": "./dist/parsers/PrattParser.js"
		},
		"./parsers/regex": {
			"types": "./dist/parsers/RegexParser.d.ts",
			"import": "./dist/parsers/RegexParser.js"
		},
		"./factory": {
			"types": "./dist/factory.d.ts",
			"import": "./dist/factory.js"
		},
		"./number": {
			"types": "./dist/number.d.ts",
			"import": "./dist/number.js"
		}
	},
	"description": "The NeutriumJS unit conversion module.",
	"keywords": [
		"neutrium",
		"unit",
		"conversion"
	],
	"license": "MIT",
	"author": "Trevor Walker <trevorw@neutrium.net> (https://neutrium.net)",
	"private": false,
	"engines": {
		"node": ">=24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/neutrium/quantity.git"
	},
	"bugs": {
		"url": "https://github.com/neutrium/quantity/issues"
	},
	"homepage": "https://neutrium.github.io/quantity/",
	"dependencies": {
		"@neutrium/decimal": "^2.3.0",
		"@neutrium/math": "2.1.0",
		"@neutrium/utilities": "5.0.0",
		"moo": "^0.5.3",
		"nearley": "^2.20.1"
	},
	"scripts": {
		"clean": "rm -rf dist src/parsers/qty-grammar.ts",
		"tsc": "tsc",
		"nearley": "nearleyc ./src/parsers/qty-grammar.ne -o ./src/parsers/qty-grammar.ts",
		"build": "pnpm run clean && pnpm run nearley && pnpm run tsc",
		"docs": "pnpm run nearley && pnpm run docs:built",
		"docs:built": "typedoc",
		"docs:dev": "pnpm run site && vite preview --config tools/docs.vite.config.mjs",
		"test": "pnpm run build && pnpm run test:built",
		"test:built": "vitest run",
		"test:package": "node tools/test-package.mjs",
		"test:package:built": "node tools/test-package.mjs --skip-build",
		"verify": "pnpm run build && pnpm run verify:built",
		"verify:built": "pnpm run test:built && pnpm run test:package:built && pnpm run test:bundles:built",
		"prepack": "node tools/prepack.mjs",
		"prepublishOnly": "pnpm run verify",
		"benchmark": "pnpm run build && vitest bench --run --config vitest.benchmark.config.js",
		"benchmark:parsers": "pnpm run build && node tools/benchmark-parsers.mjs",
		"demo": "pnpm run demo:dev",
		"demo:dev": "pnpm run build && vite --config demo/vite.config.mjs --host 127.0.0.1",
		"demo:check": "tsc -p demo/tsconfig.json",
		"demo:bundle": "pnpm run demo:check && vite build --config demo/vite.config.mjs",
		"demo:build": "pnpm run build && pnpm run demo:bundle",
		"site": "pnpm run build && pnpm run site:built",
		"site:built": "pnpm run docs:built && pnpm run demo:bundle",
		"test:bundles:built": "node tools/test-bundles.mjs"
	},
	"devDependencies": {
		"@types/moo": "^0.5.10",
		"@types/nearley": "^2.11.5",
		"typedoc": "^0.28.20",
		"typescript": "6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"types": "./dist/Quantity.d.ts",
	"files": [
		"dist",
		"src/**/*.ts",
		"src/**/*.ne",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"sideEffects": false
}
